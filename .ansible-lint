---
profile: production

exclude_paths:
  - .github/
  - .git/
  - .ansible/
  - .pre-commit-config.yaml
  - .ansible-lint
  - collections/

offline: false

# No mock_modules: ansible-lint writes mock stubs OVER the real module files in
# ~/.ansible/collections, breaking every mocked module at runtime ("Unsupported
# parameters ... Supported parameters include: ."). Install the real
# collections instead before linting:
#   ansible-galaxy collection install -r collections/requirements.yml
#   ansible-galaxy collection install -r molecule/requirements.yml

mock_roles:
  - rhel-system-roles.network
  - infra.convert2rhel.analysis
  - infra.convert2rhel.convert
  - infra.leapp.analysis
  - infra.leapp.upgrade
  - infra.leapp.remediate

warn_list:
  - experimental
  - role-name

project_dir: ./
