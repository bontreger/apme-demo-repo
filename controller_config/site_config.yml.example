---
# ACL Ready-to-Implement Content -- Site Configuration
#
# Copy this file to site_config.yml and fill in your values:
#   cp controller_config/site_config.yml.example controller_config/site_config.yml
#
# site_config.yml is gitignored and will not be committed.
# See docs/aap-deployment-guide.md for full instructions.

# ---------------------------------------------------------------------------
# AAP Connection
# ---------------------------------------------------------------------------

# Full URL of the AAP controller (include https://).
aap_hostname: https://your-aap-host.example.com

# Set to false only if the controller uses a self-signed certificate.
aap_validate_certs: true

# Personal Access Token is passed at runtime -- do NOT store it here:
#   -e aap_token=YOUR_PAT

# ---------------------------------------------------------------------------
# Project
# ---------------------------------------------------------------------------

# Git URL of the acl-ready-to-implement-content repository.
# Use SSH if authenticating with an SSH key credential:
#   git@github.com:your-org/acl-ready-to-implement-content.git
# Use HTTPS if authenticating with a token or if the repo is public:
#   https://github.com/your-org/acl-ready-to-implement-content.git
acl_project_scm_url: git@github.com:your-org/acl-ready-to-implement-content.git

# Branch for AAP to track (default: main).
acl_project_scm_branch: main

# Name of an SCM credential already created in AAP.
# Required if the repository is private; leave empty or remove for public repos.
acl_project_scm_credential: ""

# ---------------------------------------------------------------------------
# Credentials (must already exist in AAP)
# ---------------------------------------------------------------------------

# Machine credential for Linux targets (required).
acl_linux_credential: acl_machine_credential

# Machine credential for Windows targets.
# Only required if deploying Windows templates (win-*). Safe to omit for
# Linux-only deployments -- the playbook checks this conditionally.
acl_windows_credential: acl_windows_credential

# ---------------------------------------------------------------------------
# Organization and Inventory
# ---------------------------------------------------------------------------

# AAP organization that owns the project, templates, and inventory.
acl_organization: Default

# Inventory name created by the CaC playbook.
acl_inventory_name: acl_lab_inventory

# ---------------------------------------------------------------------------
# Optional: deploy only a selected subset of templates
# ---------------------------------------------------------------------------
# By default (when this key is absent or empty) all templates are deployed.
# To deploy only specific templates, list their playbook paths below.
# The ACL Library includes a Deployment Package Builder that generates this
# list automatically from the browse/filter interface.
#
# selected_playbooks:
#   - playbooks/linux-dns-primary.yml
#   - playbooks/linux-firewall-management.yml
#   - playbooks/linux-os-info-report.yml
