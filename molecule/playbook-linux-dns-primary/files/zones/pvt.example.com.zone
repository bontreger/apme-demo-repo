; Ansible-managed BIND Zone File (molecule test)
;
$TTL 3600
@   IN  SOA     instructor.pvt.example.com. root.pvt.example.com. (
                2024010101  ; Serial
                1H          ; Refresh
                15M         ; Retry
                1W          ; Expire
                1H )        ; Negative Cache TTL
;
@   IN  NS      instructor.pvt.example.com.
@   IN  NS      ns1.pvt.example.com.
@   IN  NS      ns2.pvt.example.com.

instructor  IN  A   10.77.0.10
ns1         IN  A   10.77.0.11
ns2         IN  A   10.77.0.12

dns1        IN  A   10.77.0.20
dns2        IN  A   10.77.0.21
workstation IN  A   10.77.0.100
